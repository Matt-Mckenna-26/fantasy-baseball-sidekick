# Copy this file to .env and fill in real values. NEVER commit .env.
# Yahoo app credentials (create at https://developer.yahoo.com/apps/ with Fantasy Sports "Read" permission).
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret

# Must EXACTLY match the callback URL registered on your Yahoo app.
# Local dev runs the web app over HTTPS (Vite) and proxies /auth + /api to the API,
# so the callback is the HTTPS web origin. Yahoo requires HTTPS (http is rejected).
YAHOO_REDIRECT_URI=https://localhost:5173/auth/yahoo/callback

# The web app origin the API redirects back to after login.
WEB_APP_URL=https://localhost:5173

# Long random string used to sign the session cookie (min 16 chars).
SESSION_SECRET=46845ebb-5866-417a-b66a-f354711578b4

# API server port (HTTP; the Vite dev server terminates HTTPS and proxies to it).
PORT=8787
