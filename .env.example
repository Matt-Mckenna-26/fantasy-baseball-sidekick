# Copy this file to .env and fill in real values. NEVER commit .env.
# Yahoo app credentials (create at https://developer.yahoo.com/apps/ with Fantasy Sports "Read" permission).
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret

# Must EXACTLY match the callback URL registered on your Yahoo app.
# Local dev runs the web app over HTTPS (Vite) and proxies /auth + /api to the API,
# so the callback is the HTTPS web origin. Yahoo requires HTTPS (http is rejected).
YAHOO_REDIRECT_URI=https://localhost:5173/auth/yahoo/callback

# The web app origin the API redirects back to after login.
WEB_APP_URL=https://localhost:5173

# Long random string used to sign the session cookie (min 16 chars).
SESSION_SECRET=46845ebb-5866-417a-b66a-f354711578b4

# API server port (HTTP; the Vite dev server terminates HTTPS and proxies to it).
PORT=8787

# Base64-encoded 32-byte key that encrypts persisted Yahoo tokens at rest (local dev
# file store). Must stay STABLE across restarts or previously saved tokens can't be
# decrypted (you'd just re-login). This is a secret: never commit your real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Refresh a session's Yahoo access token this many seconds before it expires, so the
# refresh runs off the request hot path instead of a mid-request retry. Optional (default 300).
TOKEN_REFRESH_SKEW_SECONDS=300

# Data source for authed Yahoo data: 'live' (real Yahoo Fantasy API) or 'mock'
# (fixture data via the same DTOs). Yahoo login is always required either way.
# Use 'mock' while Yahoo Fantasy API access is pending approval.
DATA_MODE=live

# Source for per-window PLAYER stat values: 'yahoo' (default) uses Yahoo's own coverage
# windows (today/last7/last30/season); 'mlb' derives values from the public MLB Stats API
# game logs, which unlocks arbitrary windows (e.g. Last 14) and derived categories (e.g.
# Quality Starts). Yahoo is still used for player identity, ownership, and season rank
# either way. Leave as 'yahoo' until the MLB path is validated.
STATS_SOURCE=yahoo

# --- AI co-manager chat ---
# Which LLM backs the chat: 'mock' (deterministic, offline - default; great for dev/tests)
# or 'azure' (real Azure OpenAI). When 'azure', the four AZURE_OPENAI_* vars are required.
CHAT_PROVIDER=mock

# Azure OpenAI (only needed when CHAT_PROVIDER=azure). Get these from the Azure Portal:
# your Azure OpenAI resource -> Keys and Endpoint (endpoint + KEY 1), and the model
# deployment name you created (deploy gpt-4o-mini and name the deployment gpt-4o-mini).
# The API key is a secret: never commit it. In production this moves to Key Vault +
# Managed Identity (keyless).
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# Optional Exa web-search key (https://dashboard.exa.ai/api-keys). When set, the co-manager
# gains a read-only `web_search` tool so it can ground CURRENT facts (a player's present MLB
# team, this week's sleepers, breaking news) in live web results instead of stale training
# data - and cite the articles as clickable badges. Omit to disable web search entirely.
# A secret: never commit it. In production it moves to Key Vault + Managed Identity.
# EXA_API_KEY=your-exa-api-key

# --- Production (Azure Container App) ---
# In production the same origin serves the SPA + API. Set NODE_ENV=production so the
# session cookie is Secure and the app trusts the ingress proxy (see apps/api/src/app.ts).
# Point YAHOO_REDIRECT_URI / WEB_APP_URL at the Container App HTTPS FQDN, and register that
# redirect URI on the Yahoo app. TOKEN_ENC_KEY is not used in prod (in-memory token store).
# See README "Deploy to Azure" for the full list. Secrets go in Container App secrets, not here.
# NODE_ENV=production
# YAHOO_REDIRECT_URI=https://<fqdn>/auth/yahoo/callback
# WEB_APP_URL=https://<fqdn>
